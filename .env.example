# Get this from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where to send contact form submissions
TO_EMAIL=you@yourdomain.com

# The "from" address — must be a verified domain in Resend
# Leave as default during development (uses Resend's sandbox domain)
FROM_EMAIL=Contact Form <contact@yourdomain.com>

# Comma-separated list of allowed origins (your websites)
# Example: https://www.empowerqueerhub.com,https://empowerqueer.vercel.app
ALLOWED_ORIGINS=https://www.empowerqueerhub.com,https://empowerqueer.vercel.app
