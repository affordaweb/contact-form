# ── Resend ────────────────────────────────────────────────────────────────────
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where admin notification emails are sent
TO_EMAIL=hello@affordawebsolutions.com

# Optional CC address for admin notification emails
CC_EMAIL=

# From address — must be a verified domain in Resend
FROM_EMAIL=Contact Form <hello@affordawebsolutions.com>

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed client site origins
ALLOWED_ORIGINS=https://www.empowerqueerhub.com,https://affordawebsolutions.com,https://lgbt-ku-ila.vercel.app

# ── Slack notifications ────────────────────────────────────────────────────────
# Create an Incoming Webhook at https://api.slack.com/apps
# Leave blank to disable Slack notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# ── Vercel KV submission log ───────────────────────────────────────────────────
# Connect a KV database at https://vercel.com/dashboard -> Storage
# Leave blank to disable submission logging
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Cloudflare Turnstile ───────────────────────────────────────────────────────
# Get keys at https://dash.cloudflare.com -> Turnstile
# Leave blank to disable Turnstile verification
TURNSTILE_SECRET_KEY=
